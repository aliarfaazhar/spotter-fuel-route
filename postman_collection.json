{
  "info": {
    "name": "Spotter fuel route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set base_url (default http://localhost:8000). Every 200 response draws its route and fuel stops in the response's Visualize tab."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = pm.response.json();",
          "if (pm.response.code !== 200) {",
          "  pm.test('error has the documented shape', () => pm.expect(d.error).to.have.keys('code', 'message', 'details'));",
          "} else {",
          "  pm.test('at most one routing call', () => pm.expect(d.meta.external_api_calls.routing).to.be.at.most(1));",
          "  pm.test('total = sum of stop costs', () => {",
          "    const sum = d.fuel_stops.reduce((a, s) => a + s.cost, 0);",
          "    pm.expect(Math.abs(sum - d.total_fuel_cost)).to.be.below(0.005);",
          "  });",
          "  if (d.map && d.map.route) {",
          "    const tpl = `<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css\"/>",
          "<div style=\"font:14px system-ui;margin-bottom:6px\"><b>{{cost}}</b> of fuel \u00b7 {{miles}} mi \u00b7 {{n}} stops \u00b7 {{saved}} \u00b7 routing calls: {{calls}}</div>",
          "<div id=\"m\" style=\"height:520px\"></div>",
          "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js\"></script>",
          "<script>pm.getData((e, d) => {",
          "  const map = L.map('m');",
          "  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution: '&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors'}).addTo(map);",
          "  const line = L.geoJSON(d.route, {style: {color: '#1f6feb', weight: 5}}).addTo(map); map.fitBounds(line.getBounds());",
          "  d.stops.forEach(s => L.marker([s.lat, s.lon]).bindTooltip(s.stop + '. ' + s.city + ', ' + s.state + ': $' + s.price_per_gallon + ' x ' + s.gallons + ' gal = $' + s.cost).addTo(map));",
          "});</script>`;",
          "    pm.visualizer.set(tpl, {route: d.map.route, stops: d.fuel_stops, n: d.fuel_stops.length, cost: '$' + d.total_fuel_cost,",
          "      miles: d.distance_miles, calls: d.meta.external_api_calls.routing,",
          "      saved: d.savings_vs_naive === null ? '' : '$' + d.savings_vs_naive + ' cheaper than refuelling blind'});",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "NYC -> LA (open the Visualize tab)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=New York, NY&finish=Los Angeles, CA"
      }
    },
    {
      "name": "Atlanta -> Denver (city names only)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Atlanta&finish=Denver"
      }
    },
    {
      "name": "Short trip: Dallas -> Austin",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Dallas, TX&finish=Austin, TX"
      }
    },
    {
      "name": "ZIP codes: 10001 -> 90012",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=10001&finish=90012"
      }
    },
    {
      "name": "lat,lon + an address (resolved to its city)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=40.7128,-74.0060&finish=1600 Pennsylvania Ave NW, Washington, DC"
      }
    },
    {
      "name": "Strict cheapest (stop_cost=0), full tank, no geometry",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=New York, NY&finish=Los Angeles, CA&stop_cost=0&start_fuel=full&include_route=false"
      }
    },
    {
      "name": "POST body: Chicago -> Houston, 250 mi in the tank",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"start\": \"Chicago, IL\", \"finish\": \"Houston, TX\", \"start_fuel\": \"250\"}"
        },
        "url": "{{base_url}}/api/route"
      }
    },
    {
      "name": "422: no fuel coverage (SF -> Seattle; California has 8 stations)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=San Francisco, CA&finish=Seattle, WA"
      }
    },
    {
      "name": "400: outside the USA",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Toronto, Ontario&finish=Chicago, IL"
      }
    },
    {
      "name": "400: ambiguous city",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Springfield&finish=Chicago, IL"
      }
    }
  ]
}