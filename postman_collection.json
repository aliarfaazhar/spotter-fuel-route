{
  "info": {
    "name": "Spotter fuel route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set base_url (default http://localhost:8000). Every 200 response draws its route and fuel stops in the response's Visualize tab."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = pm.response.json();",
          "if (pm.response.code !== 200) {",
          "  pm.test('error has the documented shape', () => pm.expect(d.error).to.have.keys('code', 'message', 'details'));",
          "} else {",
          "  const detour = d.route_options.length > 1;",
          "  pm.test(detour ? 'routing calls: at most 3 with a detour' : 'at most one routing call',",
          "    () => pm.expect(d.meta.external_api_calls.routing).to.be.at.most(detour ? 3 : 1));",
          "  pm.test('exactly one route option is selected', () => pm.expect(d.route_options.filter(o => o.selected).length).to.eql(1));",
          "  pm.test('total = sum of listed stop costs', () => {",
          "    const sum = d.fuel_stops.filter(s => s.listed).reduce((a, s) => a + s.cost, 0);",
          "    pm.expect(Math.abs(sum - d.total_fuel_cost)).to.be.below(0.005);",
          "  });",
          "  if (d.map && d.map.route) {",
          "    const tpl = `<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css\"/>",
          "<div style=\"font:14px system-ui;margin-bottom:6px\"><b>{{cost}}</b> of fuel · {{miles}} mi · {{n}} stops · {{saved}} · routing calls: {{calls}}</div>",
          "{{#each options}}<div style=\"font:13px system-ui;margin-bottom:4px\">{{#if selected}}✅{{else}}⛔{{/if}} <b>{{name}}</b> · {{distance_miles}} mi · {{note}}</div>{{/each}}",
          "<div id=\"m\" style=\"height:520px\"></div>",
          "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js\"></script>",
          "<script>pm.getData((e, d) => {",
          "  const map = L.map('m');",
          "  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {maxZoom: 19, attribution: 'Tiles &copy; Esri'}).addTo(map);",
          "  d.options.filter(o => o.route).forEach(o => L.geoJSON(o.route, {style: {color: '#888', weight: 4, dashArray: '6 8'}}).bindTooltip(o.name + ': ' + o.note).addTo(map));",
          "  d.options.filter(o => o.gap && o.gap.route).forEach(o => L.geoJSON(o.gap.route, {style: {color: '#d9480f', weight: 6}}).bindTooltip('No listed station for ' + o.gap.miles + ' mi').addTo(map));",
          "  const line = L.geoJSON(d.route, {style: {color: '#1f6feb', weight: 5}}).addTo(map); map.fitBounds(line.getBounds().pad(0.1));",
          "  d.stops.forEach(s => L.marker([s.lat, s.lon], {opacity: s.listed ? 1 : 0.6}).bindTooltip(s.listed",
          "    ? s.stop + '. ' + s.city + ', ' + s.state + ': $' + s.price_per_gallon + ' x ' + s.gallons + ' gal = $' + s.cost",
          "    : s.stop + '. Not in the price list: buy ' + s.gallons + ' gal at any station here (unpriced)').addTo(map));",
          "});</script>`;",
          "    pm.visualizer.set(tpl, {route: d.map.route, stops: d.fuel_stops, options: d.route_options, n: d.fuel_stops.length,",
          "      cost: '$' + d.total_fuel_cost + (d.cost_is_complete ? '' : ' + ' + d.unpriced_gallons + ' gal unpriced'),",
          "      miles: d.distance_miles, calls: d.meta.external_api_calls.routing,",
          "      saved: d.savings_vs_naive === null ? '' : '$' + d.savings_vs_naive + ' cheaper than refuelling blind'});",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "NYC -> LA (open the Visualize tab)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=New York, NY&finish=Los Angeles, CA"
      }
    },
    {
      "name": "Atlanta -> Denver (city names only)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Atlanta&finish=Denver"
      }
    },
    {
      "name": "Short trip: Dallas -> Austin",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Dallas, TX&finish=Austin, TX"
      }
    },
    {
      "name": "ZIP codes: 10001 -> 90012",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=10001&finish=90012"
      }
    },
    {
      "name": "lat,lon + an address (resolved to its city)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=40.7128,-74.0060&finish=1600 Pennsylvania Ave NW, Washington, DC"
      }
    },
    {
      "name": "Strict cheapest (stop_cost=0), full tank, no geometry",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=New York, NY&finish=Los Angeles, CA&stop_cost=0&start_fuel=full&include_route=false"
      }
    },
    {
      "name": "POST body: Chicago -> Houston, 250 mi in the tank",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"start\": \"Chicago, IL\", \"finish\": \"Houston, TX\", \"start_fuel\": \"250\"}"
        },
        "url": "{{base_url}}/api/route"
      }
    },
    {
      "name": "Detour: SF -> Seattle (direct I-5 is out of range on listed stations)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=San Francisco, CA&finish=Seattle, WA"
      }
    },
    {
      "name": "No listed station near the start: San Diego -> Sacramento (fuel shown as unpriced)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=San Diego, CA&finish=Sacramento, CA"
      }
    },
    {
      "name": "400: outside the USA",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Toronto, Ontario&finish=Chicago, IL"
      }
    },
    {
      "name": "400: ambiguous city",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/route?start=Springfield&finish=Chicago, IL"
      }
    }
  ]
}
