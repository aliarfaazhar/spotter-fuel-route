# Optional. Without a key the API uses the public OSRM server (car profile) and needs no signup.
# Free key (truck routing, 2,000 requests/day): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Development: debug pages and the browsable API. A dev-only SECRET_KEY default is used unless you set
# DJANGO_SECRET_KEY; gunicorn (Docker) refuses to start with it when DEBUG is off.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Set by docker-compose; leave unset locally to use SQLite + a file cache.
# DATABASE_URL=postgres://fuel:fuel@localhost:5432/fuel
# REDIS_URL=redis://localhost:6379/0
